ARG PYTHON_IMAGE=python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
FROM ghcr.io/astral-sh/uv:0.10.12@sha256:72ab0aeb448090480ccabb99fb5f52b0dc3c71923bffb5e2e26517a1c27b7fec AS uv

FROM ${PYTHON_IMAGE} AS common
WORKDIR /bench
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/nonexistent
RUN mkdir -p /run/telemetry-lab && chown 10001:10001 /run/telemetry-lab && chmod 0700 /run/telemetry-lab
COPY tools/telemetry_lab_container.py tools/telemetry_lab_http.py /bench/tools/

FROM common AS web
COPY benchmark/interactive_tq/web/ /bench/benchmark/interactive_tq/web/
USER 10001:10001
ENTRYPOINT ["python", "/bench/tools/telemetry_lab_container.py", "web"]

FROM ${PYTHON_IMAGE} AS dependencies
COPY --from=uv /uv /usr/local/bin/uv
COPY benchmark/interactive_tq/distribution/runtime.txt /tmp/runtime.txt
RUN uv venv /opt/venv && uv pip sync --python /opt/venv/bin/python --require-hashes \
    --no-cache --no-build --index-url https://pypi.org/simple /tmp/runtime.txt

FROM --platform=$BUILDPLATFORM ${PYTHON_IMAGE} AS assets
ARG TARGETARCH
COPY benchmark/interactive_tq/distribution/fetch_model.py /tmp/fetch_model.py
RUN python /tmp/fetch_model.py "$TARGETARCH" /model

FROM common AS worker
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/bench/src \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
COPY --from=dependencies /opt/venv /opt/venv
COPY --from=assets /model/ /bench/models/paraphrase-multilingual-MiniLM-L12-v2/
COPY src/orbios_qa_bench/__init__.py src/orbios_qa_bench/encoder.py src/orbios_qa_bench/tq_contract.py src/orbios_qa_bench/tq_answers.py src/orbios_qa_bench/tq_language.py /bench/src/orbios_qa_bench/
COPY src/orbios_qa_bench/interactive_tq/__init__.py src/orbios_qa_bench/interactive_tq/contract.py src/orbios_qa_bench/interactive_tq/planner.py src/orbios_qa_bench/interactive_tq/presentation.py src/orbios_qa_bench/interactive_tq/sandbox.py src/orbios_qa_bench/interactive_tq/service.py src/orbios_qa_bench/interactive_tq/simulator.py src/orbios_qa_bench/interactive_tq/worker.py /bench/src/orbios_qa_bench/interactive_tq/
COPY benchmark/tq_poc/catalog.json /bench/benchmark/tq_poc/catalog.json
COPY benchmark/interactive_tq/applications.json benchmark/interactive_tq/scenario.json /bench/benchmark/interactive_tq/
USER 10001:10001
ENTRYPOINT ["python", "/bench/tools/telemetry_lab_container.py", "worker"]

# Test data is available in this target only.
FROM worker AS verify
COPY src/orbios_qa_bench/interactive_tq/evaluate.py /bench/src/orbios_qa_bench/interactive_tq/evaluate.py
COPY benchmark/interactive_tq/cases.json benchmark/interactive_tq/eval_apps.json benchmark/interactive_tq/EVALUATION_FREEZE.json /bench/benchmark/interactive_tq/
COPY tests/test_interactive_tq.py /bench/tests/
ENTRYPOINT ["python"]
